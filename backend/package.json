{
  "name": "workout-tracker-backend",
  "version": "1.0.0",
  "description": "API REST para gestión de entrenamientos (Workout Tracker) - Express + Prisma + Zod + JWT",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test app.test.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "keywords": [
    "express",
    "prisma",
    "zod",
    "jwt",
    "workout-tracker"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
